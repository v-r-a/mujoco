<mujoco model="site-only general equality examples">
  <option timestep="0.002"/>
  <visual><global azimuth="125" elevation="-20"/></visual>
  <default>
    <geom type="box" size=".12 .08 .18" mass="1" contype="0" conaffinity="0"/>
    <site size=".025" rgba="1 0 0 1"/>
    <equality solref=".02 1"/>
  </default>
  <worldbody>
    <light pos="0 -2 4"/>
    <geom type="plane" size="3 3 .1" rgba=".3 .3 .3 1"/>

    <!-- Both hinge sites use a frame whose z axis points along world y. -->
    <site name="hinge_world" pos="-.7 0 1" euler="90 0 0"/>
    <body pos="-.7 0 .7">
      <freejoint/>
      <geom rgba=".2 .6 .9 1"/>
      <site name="hinge_body" pos="0 0 .3" euler="90 0 0"/>
    </body>

    <!-- Free translation is along world x (site1's local z axis). -->
    <site name="slide_world" pos="0 0 .7" euler="0 90 0"/>
    <body pos="0 0 .7">
      <freejoint/>
      <geom rgba=".3 .8 .4 1"/>
      <site name="slide_body" euler="0 90 0"/>
    </body>

    <!-- A cylindrical connection permits translation and rotation about z. -->
    <site name="cylinder_world" pos=".7 0 1"/>
    <body pos=".7 0 1">
      <freejoint/>
      <geom rgba=".9 .6 .2 1"/>
      <site name="cylinder_body"/>
    </body>
  </worldbody>
  <equality>
    <general name="hinge_y" site1="hinge_world" site2="hinge_body" lock="1 1 1 1 1 0"/>
    <general name="slide_x" site1="slide_world" site2="slide_body" lock="1 1 0 1 1 1"/>
    <general name="cylinder_z" site1="cylinder_world" site2="cylinder_body" lock="1 1 0 1 1 0"/>
  </equality>
</mujoco>
